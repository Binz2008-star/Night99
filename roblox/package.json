{
  "name": "night99-roblox",
  "version": "0.1.0",
  "private": true,
  "description": "Night 99 - Roblox port. Dark-forest survival horror with a draining flashlight and a monster that fears the light.",
  "type": "module",
  "scripts": {
    "build": "node tools/build-map.mjs",
    "check": "node tools/check-lua.mjs && node tools/check-refs.mjs",
    "check:lua": "node tools/check-lua.mjs",
    "check:refs": "node tools/check-refs.mjs",
    "serve": "rojo serve",
    "build:place": "rojo build -o Night99.rbxl"
  },
  "devDependencies": {
    "luaparse": "^0.3.1"
  }
}